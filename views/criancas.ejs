<%- include('partials/topo', { titulo: 'Crianças' }) %>
<h1>Crianças</h1>
<% if (erro) { %><div class="erro"><%= erro %></div><% } %>
<p><a class="btn" href="/criancas/nova">+ Nova criança</a></p>

<table>
  <thead>
    <tr><th>Nome</th><th>Nascimento</th><th>Responsável</th><th>Ações</th></tr>
  </thead>
  <tbody>
    <% if (criancas.length === 0) { %>
      <tr><td colspan="4">Nenhuma criança cadastrada.</td></tr>
    <% } %>
    <% criancas.forEach(c => { %>
      <tr>
        <td><%= c.nome %></td>
        <td><%= fmtData(c.data_nascimento) %></td>
        <td><%= c.responsavel_nome %></td>
        <td class="acoes">
          <a class="btn btn-peq" href="/criancas/<%= c.id %>/editar">Editar</a>
          <form method="POST" action="/criancas/<%= c.id %>/excluir" onsubmit="return confirm('Excluir esta criança e seus agendamentos?');">
            <button type="submit" class="btn-perigo btn-peq">Excluir</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/rodape') %>
