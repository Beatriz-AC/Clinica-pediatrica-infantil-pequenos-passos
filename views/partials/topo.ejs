<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> - Pequenos Passos</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; margin: 0; background: #f4f7fb; color: #243447; }
    header { background: #2b7a9e; color: #fff; padding: 12px 24px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
    header .marca { font-weight: bold; font-size: 18px; }
    header nav { display: flex; gap: 16px; flex: 1; flex-wrap: wrap; }
    header a { color: #fff; text-decoration: none; }
    header a:hover { text-decoration: underline; }
    header .usuario { font-size: 14px; display: flex; gap: 12px; align-items: center; }
    main { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
    h1 { margin-top: 0; }
    .card { background: #fff; border-radius: 8px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.1); margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: 10px; text-align: left; border-bottom: 1px solid #e3e9ef; font-size: 14px; vertical-align: middle; }
    th { background: #e8f1f6; }
    label { display: block; margin: 12px 0 4px; font-weight: bold; font-size: 14px; }
    input, select { width: 100%; padding: 9px; border: 1px solid #b8c4cf; border-radius: 6px; font-size: 14px; }
    button, .btn { display: inline-block; background: #2b7a9e; color: #fff; border: 0; padding: 9px 16px; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 14px; width: auto; }
    .btn-sec { background: #6c7a89; }
    .btn-perigo { background: #c0392b; }
    .btn-peq { padding: 5px 10px; font-size: 13px; }
    .erro { background: #fdecea; color: #a93226; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; }
    .acoes { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .acoes form { margin: 0; display: flex; gap: 6px; align-items: center; }
    .acoes input { width: auto; padding: 5px; }
    .barra { display: flex; gap: 10px; align-items: center; margin-bottom: 16px; flex-wrap: wrap; }
    .barra input { flex: 1; min-width: 200px; }
    .grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
    .grade .item { text-align: center; }
    .grade .num { font-size: 36px; font-weight: bold; color: #2b7a9e; }
    .nota { font-size: 12px; color: #6c7a89; }
    .linha-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; align-items: end; }
  </style>
</head>
<body>
<% if (usuario) { %>
<header>
  <span class="marca">Pequenos Passos</span>
  <nav>
    <a href="/painel">Início</a>
    <a href="/responsaveis">Responsáveis</a>
    <a href="/criancas">Crianças</a>
    <a href="/agendamentos">Agendamentos</a>
  </nav>
  <span class="usuario">Olá, <strong><%= usuario.nome %></strong> <a href="/logout">Sair</a></span>
</header>
<% } %>
<main>
